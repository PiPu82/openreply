# OpenReply — Self-Hosting (Docker Compose)
#
# Kopieren nach `.env` neben docker-compose.selfhost.yml, Werte einsetzen.
# Die Datei enthaelt Zugangsdaten: chmod 600, niemals ins Repo.
# .env steht in .gitignore — das bitte so lassen.

# ─── App ────────────────────────────────────────────────────────────────
# Oeffentliche URL. Ist gleichzeitig NEXTAUTH_URL, Meta-OAuth-Redirect und
# Webhook-Callback. Aendert sie sich, muessen beide Meta-Eintraege mit.
NEXTAUTH_URL=https://link.vermieterente.de

# openssl rand -base64 32
NEXTAUTH_SECRET=

# openssl rand -base64 32   — schuetzt die /api/cron/*-Endpunkte
CRON_SECRET=

# openssl rand -hex 32   — EXAKT 64 Hex-Zeichen, sonst startet die App nicht.
# Verschluesselt die Instagram-Tokens in der Datenbank.
# ⚠️ web und worker MUESSEN denselben Wert haben, sonst scheitert jeder
#    Versand an der Entschluesselung. Nie aendern, solange Konten verbunden
#    sind — sonst sind die gespeicherten Tokens unlesbar.
ENCRYPTION_KEY=

# ─── Datenbank / Queue ──────────────────────────────────────────────────
# Hostnamen sind die Compose-Servicenamen, nicht localhost.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://openreply:${POSTGRES_PASSWORD}@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# ─── Login-Mails ────────────────────────────────────────────────────────
# Anmeldung laeuft ausschliesslich ueber E-Mail-Magic-Links. Ohne
# funktionierenden Versand kommt niemand ins Dashboard.
#
# Ist EMAIL_SERVER gesetzt, nutzt die App SMTP (Auth.js Nodemailer-Provider).
# Sonst faellt sie auf Resend zurueck.
EMAIL_SERVER=smtp://<brevo-login>:<brevo-smtp-key>@smtp-relay.brevo.com:587
EMAIL_FROM=Vermieterente <service@vermieterente.de>

# Nur noetig, wenn EMAIL_SERVER leer bleibt:
# RESEND_API_KEY=

# ─── Meta / Instagram ───────────────────────────────────────────────────
# Muss zur Version der Webhook-Felder im App-Dashboard passen.
META_GRAPH_API_VERSION=v26.0

# App-Dashboard → Instagram → API-Einrichtung mit Instagram-Login
INSTAGRAM_APP_ID=1458304709461427
INSTAGRAM_APP_SECRET=

# App-Einstellungen → Allgemein → App-Geheimnis.
# Nur noetig, wenn zusaetzlich der Facebook-Login-Weg genutzt wird.
FACEBOOK_APP_SECRET=

# Frei gewaehlter String. Muss identisch im App-Dashboard unter
# Webhooks → Verifizierungstoken stehen. openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=

# ─── Cloudflare Tunnel ──────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → eigenen Tunnel anlegen → Token kopieren.
# Bewusst ein EIGENER Tunnel, nicht der vermieterente-Tunnel: der haengt in
# einem anderen Docker-Netzwerk und koennte diese Container nicht erreichen.
TUNNEL_TOKEN=

# ─── Telegram: Nachrichten, die einen Menschen brauchen ─────────────────
# Meldet eine eingehende DM, die KEINE Automatisierung beantwortet hat, in
# eine gemeinsame Gruppe — mit Direktlink in die Unterhaltung.
#
# Warum ueberhaupt: auf ~14 automatische Vorgaenge kommt eine echte
# Nachricht. Instagram kann die beiden nicht trennen (Meta liefert weder
# Ordner noch Label je Unterhaltung), also gehen echte Fragen im
# Bot-Verkehr unter. Ohne diese zwei Werte passiert schlicht nichts.
#
# Beide Zeilen leer lassen und die Werte NUR in der echten .env auf dem
# Server setzen.
#
# Chat-ID einer Gruppe ist negativ (Supergruppe: -100…). So kommt man dran:
# Bot in die Gruppe holen, dort etwas schreiben, dann
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
TELEGRAM_BOT_TOKEN=
TELEGRAM_INBOX_CHAT_ID=
