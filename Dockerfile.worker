# Worker: consumes the BullMQ send queue, sends the DMs, runs the polling
# reconciler and the follow-gate checks. Must stay running — this is not a
# serverless workload.
#
# Deliberately does NOT run `next build`. The worker only needs the generated
# Prisma client and the TypeScript sources, which tsx executes directly.
# Running the Next build here would be wasted minutes and, worse, invites the
# `prisma migrate deploy` mistake that fails without a reachable database.

FROM node:24-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Production deps only, plus the two devDependencies this image genuinely
# needs at runtime:
#   tsx    — the worker's runtime (`tsx worker/dm-worker.ts`)
#   prisma — the CLI, for `prisma migrate deploy` against the live database.
#            Without it npx would fetch it over the network on every run.
# Everything else (TypeScript, Vitest, ESLint) stays out.
RUN npm ci --omit=dev && npm install --no-save tsx prisma

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# The containers used to run in UTC, which made every "today" a UTC day —
# beginning at 02:00 German time, so entries from just after midnight were
# counted towards the day before. lib/utils/datetime pins the zone for
# everything we render or bucket ourselves; this covers the rest.
ENV TZ=Europe/Berlin

# Prisma's engines are linked against OpenSSL and probe for its version at
# startup. The slim image ships libssl but not the openssl package, so the probe
# fails and Prisma guesses ("Defaulting to openssl-1.1.x") on every run. It has
# worked regardless, but a guess is a poor thing to rely on, and the warning
# buries real output.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*


# Create the user before copying, so ownership is set by COPY --chown.
# A `chown -R` afterwards would rewrite every file into a second image layer
# and roughly double the image size.
RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs worker

COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --chown=worker:nodejs . .

# Prisma client only — no Next build. Small output, so chowning it is cheap.
RUN npx prisma generate && chown -R worker:nodejs ./app/generated

USER worker
CMD ["npm", "run", "worker"]
